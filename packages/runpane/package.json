{
  "name": "runpane",
  "version": "2.4.129",
  "description": "Thin npm installer and remote setup CLI for Pane",
  "license": "AGPL-3.0",
  "homepage": "https://runpane.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenfield-inc/Pane.git",
    "directory": "packages/runpane"
  },
  "bugs": {
    "url": "https://github.com/greenfield-inc/Pane/issues"
  },
  "bin": {
    "runpane": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle-mcp-sdk.js && node scripts/mark-executable.js",
    "lint": "pnpm --dir ../.. run lint:ox:runpane && pnpm run lint:eslint",
    "lint:eslint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@modelcontextprotocol/sdk": "1.16.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.10.2",
    "esbuild": "0.25.7",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
