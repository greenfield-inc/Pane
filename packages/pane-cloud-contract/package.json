{
  "name": "pane-cloud-contract",
  "version": "0.1.0",
  "private": true,
  "description": "The Pane Cloud service API and fleet API: schemas, typed clients, stub servers and contract tests",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenfield-inc/Pane.git",
    "directory": "packages/pane-cloud-contract"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stubs": {
      "types": "./dist/stubs/index.d.ts",
      "default": "./dist/stubs/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:dist": "pnpm run build && git diff --exit-code -- dist && test -z \"$(git status --porcelain -- dist)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "pnpm --dir ../.. exec oxlint --config .oxlintrc.json packages/pane-cloud-contract"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
