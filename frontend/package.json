{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && node ../scripts/verify-xterm-request-mode-build.js && node ../scripts/verify-react-scan-build.js",
    "preview": "vite preview",
    "lint": "pnpm --dir .. run lint:ox:frontend && pnpm run lint:eslint",
    "lint:eslint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
