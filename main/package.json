{
  "name": "main",
  "version": "0.0.1",
  "description": "Electron main process for Claude Code Commander",
  "main": "dist/main/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc -w",
    "build": "rimraf dist && tsc && npm run bundle:preload && npm run copy:assets && npm run bundle:mcp && npm run bundle:runpane",
    "headless": "npm run build && electron dist/main/src/daemon/headless.js",
    "bundle:mcp": "node build-mcp-bridge.js",
    "bundle:runpane": "node build-runpane.js",
    "bundle:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --sourcemap --outfile=dist/main/src/preload.js && node ../scripts/verify-sandboxed-preload.js",
    "copy:assets": "mkdirp dist/main/src/database/migrations dist/main/assets dist/main/src/services && shx cp src/database/*.sql dist/main/src/database/ && shx cp src/database/migrations/*.sql dist/main/src/database/migrations/ && shx cp assets/icon.png dist/main/assets/ && shx cp -r src/services/paneChatBundle dist/main/src/services/",
    "lint": "pnpm --dir .. run lint:ox:main && pnpm run lint:eslint",
    "lint:eslint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@lydell/node-pty": "1.2.0-beta.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "bull": "^4.16.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.6.8",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.1",
    "smol-toml": "1.7.1",
    "uuid": "^13.0.0",
    "web-streams-polyfill": "^3.3.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "41.10.3",
    "eslint": "^9.17.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.0.1",
    "shx": "^0.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
