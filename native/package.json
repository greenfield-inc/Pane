{
  "name": "@pane/native",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --port ${RCT_METRO_PORT:-8137}",
    "ios": "expo run:ios --port ${RCT_METRO_PORT:-8137}",
    "android": "expo run:android --port ${RCT_METRO_PORT:-8137}",
    "prebuild": "expo prebuild --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p terminal-web",
    "build:terminal-web": "node scripts/build-terminal-web.mjs"
  },
  "dependencies": {
    "@legendapp/list": "~3.3.11",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.2",
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "esbuild": "0.25.7",
    "typescript": "~6.0.3",
    "vitest": "3.2.6"
  }
}
