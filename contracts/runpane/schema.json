    "helpLines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "agentContext": {
      "type": "object",
      "required": [
        "brief",
        "commands",
        "managedBlock",
        "intro",
        "workspaceRules"
      ],
      "properties": {
        "intro": {
          "type": "object",
          "required": ["humans", "agents"],
          "properties": {
            "humans": { "$ref": "#/$defs/agentContextIntroPart" },
            "agents": { "$ref": "#/$defs/agentContextIntroPart" }
          },
          "additionalProperties": false,
          "description": "What Pane is and how to work in it, people first, then agents. The surfaces agents and people read first render it."
        },
        "workspaceRules": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Where work goes in Pane: Session, Pane, tab and scratch."
        },
        "brief": {
          "$ref": "#/$defs/agentContextBrief"
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/agentContextCommand"
          }
        },
        "managedBlock": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "notifyGuidance": {
          "$ref": "#/$defs/notifyGuidance"
        }
      },
      "additionalProperties": false
    },
    "notifyGuidance": {
      "description": "The notify rules every agent needs before it asks: Pane's user-level instruction block reads them. How to write the card lives in the notify command's notes, which agents read when they call it.",
      "type": "object",
      "required": ["rules"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "agentContextIntroPart": {
      "type": "object",
      "required": ["title", "sentences", "approvals"],
      "properties": {
        "title": { "type": "string" },
        "sentences": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "One entry is the literal \"{approvals}\", replaced by approvals.on or approvals.off from the live Approvals setting."
        },
        "approvals": {
          "type": "object",
          "required": ["on", "off"],
          "properties": { "on": { "type": "string" }, "off": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agentContextBrief": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "rules",
        "detailCommand",
        "tools"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "$ref": "#/$defs/stringList"
        },
        "detailCommand": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/agentContextTool"
          }
        }
      },
      "additionalProperties": false
    },
    "agentContextTool": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "agentContextCommand": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "details",
        "arguments",
        "examples"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "requiresPaneDaemon": {
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentContextArgument"
          }
        },
        "examples": {
          "$ref": "#/$defs/stringList"
        },
        "jsonSchemas": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "helpIncludesNotes": {
          "description": "`runpane <command> --help` prints the notes too, so agents that only run the CLI read what the MCP tool description says.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agentContextArgument": {
      "type": "object",
      "required": [
        "name",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "description": "JSON Schema for this argument's MCP tool input when it takes an array, object, or enum. Array and object values reach the CLI as JSON.",
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
