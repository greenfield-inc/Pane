{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runpane.com/schemas/runpane-contract.schema.json",
  "title": "Runpane public contract manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "description",
    "packageInstallPolicy",
    "compatibility",
    "terminology",
    "defaults",
    "enums",
    "agents",
    "agentContext",
    "commands",
    "flags",
    "help",
    "docs",
    "testFixtures",
    "jsonSchemas"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "runpane"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packageInstallPolicy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "compatibility": {
      "type": "object",
      "required": [
        "node",
        "python"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "terminology": {
      "type": "object",
      "required": [
        "repo",
        "pane",
        "tool",
        "agent"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "pane": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": [
        "target",
        "paneVersion",
        "channel",
        "format",
        "dryRun",
        "yes",
        "verbose",
        "watch"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "paneVersion": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "yes": {
          "type": "boolean"
        },
        "verbose": {
          "type": "boolean"
        },
        "watch": {
          "type": "object",
          "required": [
            "follow",
            "untilEvent"
          ],
          "additionalProperties": false,
          "properties": {
            "follow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "kinds",
                "readySettle",
                "blockedSettle",
                "minInterval",
                "idleAfter",
                "idleBackoff",
                "expireAfter",
                "heartbeat",
                "includeShells",
                "heldInputDetection"
              ],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "kinds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "readySettle": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "blockedSettle": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "minInterval": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "idleAfter": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "idleBackoff": {
                  "type": "boolean"
                },
                "expireAfter": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "heartbeat": {
                  "type": "string",
                  "pattern": "^(off|[0-9]+(ms|s|m|h))$"
                },
                "includeShells": {
                  "type": "boolean"
                },
                "heldInputDetection": {
                  "type": "boolean"
                }
              }
            },
            "untilEvent": {
              "type": "object",
              "required": [
                "summary",
                "kinds"
              ],
              "properties": {
                "summary": {
                  "type": "string"
                },
                "kinds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    },
    "enums": {
      "type": "object",
      "required": [
        "installTargets",
        "artifactFormats",
        "channels",
        "agents"
      ],
      "properties": {
        "installTargets": {
          "$ref": "#/$defs/stringList"
        },
        "artifactFormats": {
          "$ref": "#/$defs/stringList"
        },
        "channels": {
          "$ref": "#/$defs/stringList"
        },
        "agents": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "description": "Every agent fact Pane uses, for terminal and chat tabs alike. Code reads these; it never names an agent.",
      "$ref": "#/$defs/agents"
    },
    "terminalKeys": {
      "description": "Named keys for `panels input --keys`, mapped to the bytes a terminal receives.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "minItems": 1
    },
    "flags": {
      "type": "object",
      "required": [
        "wrapper",
        "remoteValue",
        "remoteBoolean",
        "localValue",
        "localBoolean"
      ],
      "properties": {
        "wrapper": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "remoteValue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "remoteBoolean": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "localValue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "localBoolean": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        }
      },
      "additionalProperties": false
    },
    "help": {
      "type": "object",
      "required": [
        "npm",
        "pip"
      ],
      "properties": {
        "npm": {
          "$ref": "#/$defs/helpSurface"
        },
        "pip": {
          "$ref": "#/$defs/helpSurface"
        }
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object"
    },
    "testFixtures": {
      "type": "object"
    },
    "jsonSchemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "agentContext": {
      "$ref": "#/$defs/agentContext"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "command": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "usage",
        "localControl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/stringList"
        },
        "interactiveEntrypoint": {
          "type": "boolean"
        },
        "defaultTarget": {
          "type": "string"
        },
        "targets": {
          "$ref": "#/$defs/stringList"
        },
        "target": {
          "type": "string"
        },
        "unknownDaemonFlagsForwarded": {
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        },
        "additive": {
          "description": "A mutating command that only adds state, never changes or removes it (MCP destructiveHint false).",
          "type": "boolean"
        },
        "idempotent": {
          "description": "Repeating the command with the same arguments has no further effect (MCP idempotentHint).",
          "type": "boolean"
        },
        "openWorld": {
          "description": "The command can reach services outside the local Pane app (MCP openWorldHint).",
          "type": "boolean"
        },
        "toolsets": {
          "description": "MCP toolsets that serve this command; see runpane mcp --toolsets.",
          "$ref": "#/$defs/stringList"
        },
        "wrappers": {
          "description": "Wrappers that implement the command; both when absent.",
          "type": "array",
          "items": {
            "enum": [
              "npm",
              "pip"
            ]
          }
        },
        "daemonAction": {
          "description": "Invoke this Pane daemon channel with the listed flags' values as positional arguments.",
          "type": "object",
          "required": [
            "channel",
            "args"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "$ref": "#/$defs/stringList"
            }
          },
          "additionalProperties": false
        },
        "jsonSchemas": {
          "$ref": "#/$defs/stringList"
        },
        "localControl": {
          "type": "boolean",
          "description": "Whether the command accepts the shared local-control flags."
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "required": [
        "default",
        "registryUrl",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "description": "The agent a new Session and the first-run screen start with.",
          "type": "string",
          "minLength": 1
        },
        "registryUrl": {
          "description": "The ACP Registry index Settings > Agents installs from.",
          "type": "string",
          "pattern": "^https://"
        },
        "entries": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/agent"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "title",
        "label",
        "icon",
        "executables",
        "terminal",
        "install"
      ],
      "dependentRequired": {
        "chat": [
          "signIn"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Full name, used for terminal tab titles.",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "Short name for menus and chat headings.",
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "description": "Key into the clients' brand icon registry; unknown keys get a generic icon.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "executables": {
          "description": "CLI names on PATH. The first one launches; all of them identify the agent in a command.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transcriptDirs": {
          "description": "Folders, relative to the home the CLI runs with (POSIX separators), that hold its session transcripts. Before Pane deletes a folder it owns, it moves these out of it into <pane-dir>/agent-logs/<agent>/.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal": {
          "type": "object",
          "required": [
            "args",
            "fullAccessArgs",
            "hotkey"
          ],
          "additionalProperties": false,
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fullAccessArgs": {
              "description": "Flags that let the agent act without asking. The terminal launch command is the executable, these flags, then args.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hotkey": {
              "type": "string",
              "minLength": 1
            },
            "reportsConversation": {
              "description": "Pane's SessionStart hook reports the terminal's live conversation, so Switch to chat can be sure which one it is on.",
              "type": "boolean"
            },
            "paneMcpConfigFlag": {
              "description": "The flag that takes an MCP config file for one launch (written as <flag>=<file>), whose `pane` server replaces the user-level one. Terminal tabs Pane starts then reach Pane's tools over its loopback HTTP endpoint.",
              "type": "string",
              "pattern": "^--"
            },
            "promptArgument": {
              "description": "The CLI takes the starting message as a command argument. Without it, Pane types the message into the agent's input box once the status manifest shows that box idle.",
              "type": "boolean"
            },
            "configDir": {
              "description": "The CLI's project config folder, copied into new worktrees by default.",
              "type": "string",
              "minLength": 1
            },
            "session": {
              "description": "How the CLI opens a saved conversation from the command line.",
              "type": "object",
              "required": [
                "flag",
                "minimumVersion",
                "idPattern"
              ],
              "additionalProperties": false,
              "properties": {
                "flag": {
                  "description": "The flag that opens a conversation by id.",
                  "type": "string",
                  "minLength": 1
                },
                "minimumVersion": {
                  "description": "Oldest CLI version with the flag; the agents doctor checks the CLI's --help for the flag.",
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "idPattern": {
                  "description": "Regular expression a conversation id must match.",
                  "type": "string",
                  "minLength": 1
                },
                "paneChoosesId": {
                  "description": "The flag also creates the conversation when none has the id, so Pane picks the id and every launch runs the same command.",
                  "type": "boolean"
                },
                "selectors": {
                  "description": "Flags with which a command picks its own conversation; Pane then runs that command unchanged.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "install": {
          "type": "object",
          "required": [
            "url",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "command": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "signIn": {
          "description": "Arguments to the agent's CLI that sign it in, run in a terminal tab when a chat agent advertises no terminal sign-in of its own. Required with chat.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "onboarding": {
          "description": "Offered on the first-run screen.",
          "type": "boolean"
        },
        "onboardingPanelId": {
          "description": "The saved panel id of this agent's Onboarding Session terminal, for an agent whose id predates the derived form. Others use __pane_chat_terminal_<id>__.",
          "type": "string",
          "minLength": 1
        },
        "chat": {
          "$ref": "#/$defs/agentChat"
        }
      }
    },
    "agentChat": {
      "type": "object",
      "required": [
        "minimumVersion",
        "terminalConversationsLoad"
      ],
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Arguments that start the agent's own CLI as an ACP agent. Absent when a bundled adapter runs it.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapter": {
          "description": "A bundled ACP adapter package (pinned in package.json) that runs the person's CLI.",
          "type": "object",
          "required": [
            "package",
            "executableEnv"
          ],
          "additionalProperties": false,
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "executableEnv": {
              "description": "The variable that points the adapter at the CLI.",
              "type": "string",
              "minLength": 1
            },
            "npmShimScript": {
              "description": "On Windows, the script a standard npm shim for the CLI runs, relative to node_modules.",
              "type": "string",
              "minLength": 1
            },
            "sessionFolderSettingsMeta": {
              "description": "The _meta namespace under which the adapter accepts Session folder settings (`options.settings`) on session/new and session/load.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "apiKeyEnv": {
          "description": "Variables an API key saved in Settings is passed as.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fullAccess": {
          "description": "How the agent acts without asking: a session mode, or the terminal fullAccessArgs passed to the chat CLI. Absent: Pane answers each request with allow once.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "const": true
            }
          }
        },
        "riskyModes": {
          "description": "Session modes in which the agent acts without asking.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacyClients": {
          "description": "Pane apps from before the agent catalog can show this agent's chat tabs. The host hides every other agent's chat tabs from them.",
          "type": "boolean"
        },
        "terminalConversationsLoad": {
          "description": "A chat can load a conversation the agent's terminal started (Switch to chat).",
          "type": "boolean"
        },
        "paneMcpHttp": {
          "description": "Chat tabs pass Pane's MCP server to the agent over HTTP in session/new, and the agent uses it in place of a user-level server of the same name.",
          "type": "boolean"
        },
        "registryIds": {
          "description": "ACP Registry ids this agent covers; Settings > Agents hides them.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^--"
        },
        "value": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "helpSurface": {
      "type": "object",
      "required": [
        "default",
        "install",
        "setup",
        "update",
        "version",
        "doctor",
        "daemon repair",
        "agents doctor",
        "repos list",
        "repos add",
        "repos get",
        "repos update",
        "repos rename",
        "secrets",
        "secrets list",
        "secrets set",
        "secrets delete",
        "secrets exec",
        "secrets request",
        "panes",
        "panes list",
        "panes cost",
        "workspace",
        "workspace state",
        "workspace list",
        "workspace enable",
        "workspace disable",
        "workspace read",
        "workspace write",
        "workspace exec",
        "handoff",
        "watch",
        "panes create",
        "panes adopt",
        "panes archive",
        "panes pin",
        "panes unpin",
        "panes pause",
        "panes resume",
        "panes rename",
        "panes focus",
        "panels",
        "panels create",
        "panels open",
        "panels close",
        "panels list",
        "panels output",
        "panels input",
        "panels screen",
        "panels submit",
        "panels submit-composer",
        "panels wait",
        "panels resume",
        "panels pause",
        "panels last-message",
        "panels conversation",
        "panels close",
        "agent-context",
        "mcp",
        "panes git-status",
        "panes commit",
        "panes push",
        "panes pull",
        "panes rebase-main",
        "panes restore",
        "panes squash-rebase",
        "panes stash",
        "panes stash-pop",
        "panes soft-reset",
        "panes fetch",
        "panes run-script",
        "panes stop-script",
        "panes move",
        "folders list",
        "folders create",
        "links create",
        "links open",
        "docs search",
        "docs read",
        "agents start",
        "agents status",
        "agents send",
        "report",
        "notify",
        "inbox",
        "inbox ack",
        "autopilot",
        "autopilot status",
        "autopilot waiting",
        "autopilot stack",
        "autopilot stack push",
        "autopilot answer",
        "autopilot close",
        "autopilot rewrite",
        "sessions",
        "sessions list",
        "sessions create",
        "sessions get",
        "sessions update",
        "sessions pin",
        "sessions unpin",
        "sessions pause",
        "sessions resume",
        "sessions set-agent",
        "sessions associate",
        "sessions detach",
        "sessions overview",
        "lock",
        "lock acquire",
        "lock release",
        "lock list",
        "loops",
        "loops list",
        "loops create",
        "loops update",
        "loops run",
        "loops pause",
        "loops resume",
        "loops delete"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/helpLines"
        },
        "install": {
          "$ref": "#/$defs/helpLines"
        },
        "setup": {
          "$ref": "#/$defs/helpLines"
        },
        "update": {
          "$ref": "#/$defs/helpLines"
        },
        "version": {
          "$ref": "#/$defs/helpLines"
        },
        "doctor": {
          "$ref": "#/$defs/helpLines"
        },
        "daemon repair": {
          "$ref": "#/$defs/helpLines"
        },
        "agents doctor": {
          "$ref": "#/$defs/helpLines"
        },
        "repos list": {
          "$ref": "#/$defs/helpLines"
        },
        "repos add": {
          "$ref": "#/$defs/helpLines"
        },
        "repos get": {
          "$ref": "#/$defs/helpLines"
        },
        "repos update": {
          "$ref": "#/$defs/helpLines"
        },
        "repos rename": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets list": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets set": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets delete": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets exec": {
          "$ref": "#/$defs/helpLines"
        },
        "secrets request": {
          "$ref": "#/$defs/helpLines"
        },
        "panes": {
          "$ref": "#/$defs/helpLines"
        },
        "panes list": {
          "$ref": "#/$defs/helpLines"
        },
        "panes cost": {
          "$ref": "#/$defs/helpLines"
        },
        "workspace": {
          "$ref": "#/$defs/helpLines"
        },
        "workspace state": {
          "$ref": "#/$defs/helpLines"
        },
        "workspace list": {
          "$ref": "#/$defs/helpLines"
        },
        "workspace enable": {
