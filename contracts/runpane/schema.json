{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runpane.com/schemas/runpane-contract.schema.json",
  "title": "Runpane public contract manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "description",
    "packageInstallPolicy",
    "compatibility",
    "terminology",
    "defaults",
    "enums",
    "agentTemplates",
    "agentContext",
    "commands",
    "flags",
    "help",
    "docs",
    "testFixtures",
    "jsonSchemas"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "const": "runpane"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packageInstallPolicy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "compatibility": {
      "type": "object",
      "required": [
        "node",
        "python"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "terminology": {
      "type": "object",
      "required": [
        "repo",
        "pane",
        "tool",
        "agent"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "pane": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": [
        "target",
        "paneVersion",
        "channel",
        "format",
        "dryRun",
        "yes",
        "verbose",
        "watch"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "paneVersion": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "dryRun": {
          "type": "boolean"
        },
        "yes": {
          "type": "boolean"
        },
        "verbose": {
          "type": "boolean"
        },
        "watch": {
          "type": "object",
          "required": [
            "format",
            "heartbeatSeconds",
            "idleAfterMs",
            "settleMs",
            "blockedSettleMs",
            "minIntervalMs",
            "idleBackoff",
            "agentsOnly",
            "includeHeldInputPresence"
          ],
          "properties": {
            "format": {
              "enum": [
                "lines",
                "json"
              ]
            },
            "heartbeatSeconds": {
              "type": "number"
            },
            "idleAfterMs": {
              "type": "number"
            },
            "settleMs": {
              "type": "number"
            },
            "blockedSettleMs": {
              "type": "number"
            },
            "minIntervalMs": {
              "type": "number"
            },
            "idleBackoff": {
              "type": "boolean"
            },
            "agentsOnly": {
              "type": "boolean"
            },
            "includeHeldInputPresence": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "enums": {
      "type": "object",
      "required": [
        "installTargets",
        "artifactFormats",
        "channels",
        "agents"
      ],
      "properties": {
        "installTargets": {
          "$ref": "#/$defs/stringList"
        },
        "artifactFormats": {
          "$ref": "#/$defs/stringList"
        },
        "channels": {
          "$ref": "#/$defs/stringList"
        },
        "agents": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "agentTemplates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/agentTemplate"
      }
    },
    "terminalKeys": {
      "description": "Named keys for `panels input --keys`, mapped to the bytes a terminal receives.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "minItems": 1
    },
    "flags": {
      "type": "object",
      "required": [
        "wrapper",
        "remoteValue",
        "remoteBoolean",
        "localValue",
        "localBoolean"
      ],
      "properties": {
        "wrapper": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "remoteValue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "remoteBoolean": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "localValue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "localBoolean": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        }
      },
      "additionalProperties": false
    },
    "help": {
      "type": "object",
      "required": [
        "npm",
        "pip"
      ],
      "properties": {
        "npm": {
          "$ref": "#/$defs/helpSurface"
        },
        "pip": {
          "$ref": "#/$defs/helpSurface"
        }
      },
      "additionalProperties": false
    },
    "docs": {
      "type": "object"
    },
    "testFixtures": {
      "type": "object"
    },
    "jsonSchemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "agentContext": {
      "$ref": "#/$defs/agentContext"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "command": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "usage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/stringList"
        },
        "interactiveEntrypoint": {
          "type": "boolean"
        },
        "defaultTarget": {
          "type": "string"
        },
        "targets": {
          "$ref": "#/$defs/stringList"
        },
        "target": {
          "type": "string"
        },
        "unknownDaemonFlagsForwarded": {
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        },
        "additive": {
          "description": "A mutating command that only adds state, never changes or removes it (MCP destructiveHint false).",
          "type": "boolean"
        },
        "idempotent": {
          "description": "Repeating the command with the same arguments has no further effect (MCP idempotentHint).",
          "type": "boolean"
        },
        "openWorld": {
          "description": "The command can reach services outside the local Pane app (MCP openWorldHint).",
          "type": "boolean"
        },
        "toolsets": {
          "description": "MCP toolsets that serve this command; see runpane mcp --toolsets.",
          "$ref": "#/$defs/stringList"
        },
        "wrappers": {
          "description": "Wrappers that implement the command; both when absent.",
          "type": "array",
          "items": {
            "enum": [
              "npm",
              "pip"
            ]
          }
        },
        "daemonAction": {
          "description": "Invoke this Pane daemon channel with the listed flags' values as positional arguments.",
          "type": "object",
          "required": [
            "channel",
            "args"
          ],
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "description": "Flags whose values become the channel's positional arguments; empty for a channel that takes none.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "jsonSchemas": {
          "$ref": "#/$defs/stringList"
        }
      },
      "additionalProperties": false
    },
    "agentTemplate": {
      "type": "object",
      "required": [
        "title",
        "command"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^--"
        },
        "value": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
